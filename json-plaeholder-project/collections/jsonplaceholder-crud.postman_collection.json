{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "JSONPlaceholder CRUD Chain",
    "description": "Chained CRUD flow against JSONPlaceholder: POST create, GET, PUT, GET verify, DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Response contains created post id', function () {",
              "    pm.expect(jsonData).to.have.property('id');",
              "});",
              "",
              "pm.collectionVariables.set('createdPostId', String(jsonData.id));",
              "pm.collectionVariables.set('createdTitle', jsonData.title);",
              "pm.collectionVariables.set('createdBody', jsonData.body);",
              "pm.collectionVariables.set('createdUserId', String(jsonData.userId));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Newman chained post\",\n  \"body\": \"Created for chained CRUD flow\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts",
            ""
          ]
        },
        "description": "Create a new post and store response values for downstream requests."
      },
      "response": []
    },
    {
      "name": "2. Get Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Post id is 1', function () {",
              "    pm.expect(jsonData.id).to.eql(1);",
              "});",
              "",
              "pm.collectionVariables.set('existingTitle', jsonData.title);",
              "pm.collectionVariables.set('existingBody', jsonData.body);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "description": "Fetch post 1 and capture current title/body for the update step."
      },
      "response": []
    },
    {
      "name": "3. Update Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Updated title matches request', function () {",
              "    pm.expect(jsonData.title).to.eql(pm.collectionVariables.get('updatedTitle'));",
              "});",
              "",
              "pm.test('Updated body matches request', function () {",
              "    pm.expect(jsonData.body).to.eql(pm.collectionVariables.get('updatedBody'));",
              "});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const updatedTitle = 'Updated via Newman chain';",
              "const updatedBody = 'PUT chained after create and GET';",
              "",
              "pm.collectionVariables.set('updatedTitle', updatedTitle);",
              "pm.collectionVariables.set('updatedBody', updatedBody);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"{{updatedTitle}}\",\n  \"body\": \"{{updatedBody}}\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "description": "Update post 1 using values prepared from the previous chain steps."
      },
      "response": []
    },
    {
      "name": "4. Verify Updated Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Post id is still 1', function () {",
              "    pm.expect(jsonData.id).to.eql(1);",
              "});",
              "",
              "pm.test('Created post id was captured earlier', function () {",
              "    pm.expect(pm.collectionVariables.get('createdPostId')).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "description": "Re-fetch post 1 after the PUT step to complete the read-update-verify chain."
      },
      "response": []
    },
    {
      "name": "5. Delete Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Delete completes the CRUD chain', function () {",
              "    pm.expect(pm.collectionVariables.get('createdPostId')).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
