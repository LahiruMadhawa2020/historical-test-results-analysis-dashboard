{
  "name": "json-plaeholder-project",
  "version": "1.0.0",
  "description": "Newman runner for JSONPlaceholder Postman collection",
  "scripts": {
    "test": "newman run collections/jsonplaceholder-crud.postman_collection.json --reporters cli,json,htmlextra --reporter-htmlextra-export reports/newman-report.html",
    "test:html": "newman run collections/jsonplaceholder-crud.postman_collection.json --reporters cli,json,htmlextra --reporter-htmlextra-export reports/newman-report.html",
    "dashboard:generate": "analytics-dashboard generate",
    "dashboard:import:newman": "analytics-dashboard import reports/newman-run.json --format newman-json --tool newman"
  },
  "devDependencies": {
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.0"
  },
  "dependencies": {
    "historical-analytics-dashboard": "https://github.com/publisheswithlahiru91/historical-test-results-analysis-dashboard.git"
  }
}
